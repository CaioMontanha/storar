# Storar development secrets should be overridden outside local development.
DJANGO_SECRET_KEY=replace-this-for-deployments
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset to use backend/db.sqlite3. For PostgreSQL, use a URL such as:
# DATABASE_URL=postgresql://user:password@localhost:5432/storar
# CORS_ALLOWED_ORIGINS=http://localhost:5173
